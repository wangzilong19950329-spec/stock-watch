# Local process environment; no real credentials are committed.
STOCK_WATCH_PORT=8117
STOCK_WATCH_BIND_ADDRESS=127.0.0.1
STOCK_WATCH_DATA_DIR=./data
# Default: embedded H2. For MySQL, create a NEW stock_watch database, then enable:
# SPRING_PROFILES_ACTIVE=mysql
# STOCK_WATCH_DB_URL='jdbc:mysql://127.0.0.1:3306/stock_watch?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai'
# STOCK_WATCH_DB_USERNAME=stock_watch
# STOCK_WATCH_DB_PASSWORD=
STOCK_WATCH_MONITOR_ENABLED=false
STOCK_WATCH_NOTIFY_ENABLED=false
STOCK_WATCH_TECH_ANALYSIS_ENABLED=false
STOCK_WATCH_DELIVERY_ENABLED=false
STOCK_WATCH_SYMBOLS=
STOCK_WATCH_RULES=
# API model is separate from the logged-in DeepSeek website.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
# Independent bridge/profile: does not reuse the original project's browser or database.
DEEPSEEK_WEB_BRIDGE_PORT=8790
DEEPSEEK_WEB_DEBUG_PORT=9334
DEEPSEEK_WEB_BRIDGE_URL=http://127.0.0.1:8790/search
# DEEPSEEK_WEB_CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
